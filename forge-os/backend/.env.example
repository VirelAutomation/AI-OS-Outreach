# FORGE OS backend environment.
# Copy to backend/.env.local for local development only.
# In cloud environments, set these as Railway service variables.
# Never expose these values through VITE_* variables.

NODE_ENV=development
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUIRE_API_KEY=false
BACKEND_API_KEY=replace_with_backend_api_key_before_production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Supabase admin
SUPABASE_URL=https://fhwrmbvyazdlhfxhdwtc.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_secret_key
SUPABASE_JWT_KEY_ID=21d42d78-985a-449e-9f3a-c587be0f1e51
SUPABASE_LEGACY_JWT_SECRET=replace_with_legacy_secret

# Gemini / Google GenAI
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_API_KEY_JARVIS=replace_with_jarvis_key
GEMINI_API_KEY_DAMIEN=replace_with_damien_key
GEMINI_API_KEY_NOAH=replace_with_noah_key
GEMINI_API_KEY_ZOYA=replace_with_zoya_key
GEMINI_API_KEY_DEVAN=replace_with_devan_key
GEMINI_API_KEY_AKHIL=replace_with_akhil_key
GEMINI_API_KEY_KING=replace_with_king_key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_RETRIES=4
GEMINI_INITIAL_WAIT_MS=60000

# Hugging Face routed open-model fallback
HF_TOKEN=replace_with_huggingface_user_access_token
HF_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
HF_PROVIDER=auto

# Google OAuth + Gmail
# Refresh tokens can be bootstrapped from env for local dev, or saved through
# /api/google/oauth/callback into the cloud runtime store backed by forge_settings.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
GOOGLE_CLIENT_ID_BACKUP=
GOOGLE_CLIENT_SECRET_BACKUP=
GOOGLE_REDIRECT_URI_BACKUP=http://localhost:8000/api/google/oauth/callback
GOOGLE_ACTIVE_PROFILE=primary
GOOGLE_PROFILE_FAILOVER_ENABLED=true
GMAIL_REFRESH_TOKEN=replace_after_oauth_flow
GMAIL_SENDER_EMAIL=replace_with_sender_email
GMAIL_REFRESH_TOKEN_BACKUP=
GMAIL_SENDER_EMAIL_BACKUP=
GMAIL_DAILY_SEND_CAP_PER_ACCOUNT=100
GOOGLE_MAPS_API_KEY=

API_OUTBOUND_TIMEOUT_MS=15000
API_OUTBOUND_ALLOWLIST=generativelanguage.googleapis.com,oauth2.googleapis.com,gmail.googleapis.com,www.googleapis.com,api.apify.com,maps.googleapis.com,router.huggingface.co

# Queues/cache
REDIS_URL=redis://localhost:6379

# Apollo / research enrichment
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Apify lead sourcing
APIFY_API_TOKEN=replace_with_apify_api_token
APIFY_ACTOR_ID=replace_with_apify_actor_id

# Future backend provider
UPSIDE_API_URL=
UPSIDE_API_KEY=
