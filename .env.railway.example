# AI OS Backend — Render / Railway environment template
# Copy values into Render Dashboard → Environment (or Railway Variables).
# Do NOT commit real secrets to git.

PORT=8000
DATA_DIR=/data
APP_ENV=production
API_SECRET_KEY=change-me-to-a-long-random-string
PYTHONUNBUFFERED=1
IG_HEADLESS=1

# Supabase (required — FastAPI fails without these)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Redis (required — use rediss:// for Upstash TLS)
REDIS_URL=
REDIS_PASSWORD=

# AI keys
GEMINI_API_KEY=
GEMINI_API_KEY_JARVIS=
GEMINI_API_KEY_DAMIEN=
GEMINI_API_KEY_NOAH=
GEMINI_API_KEY_ZOYA=
GEMINI_API_KEY_DEVAN=
GEMINI_API_KEY_AKHIL=
GEMINI_API_KEY_KING=
ANTHROPIC_API_KEY=

# Instagram (INSTAGRAM_SESSION or INSTAGRAM_SESSION_ID required on cloud)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION=
INSTAGRAM_SESSION_ID=

# Facebook
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
FACEBOOK_SESSION=

# Gmail outreach
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# CORS — add your Netlify/Vercel frontend URL
CORS_ALLOW_ORIGINS=https://your-frontend.netlify.app

# Optional limits
INSTAGRAM_DAILY_DM_LIMIT=20
INSTAGRAM_DAILY_COMMENT_LIMIT=150
FACEBOOK_DAILY_POST_LIMIT=10
FACEBOOK_DAILY_DM_LIMIT=15
